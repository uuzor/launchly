# Copy to .env (never commit .env) and fill in. See backend.md §5.
# Verifier/keeper keys live in the `near` CLI keychain, NOT here.

# Random 32-byte operator token. api.py refuses to start without it
# (or with the literal value "change-me").
OPERATOR_TOKEN=

# SQLite file for backend state.
BACKEND_DB=intents.db

# Local port for api.py.
PORT=8090

# Deployed main contract, e.g. launchlyv5-1105.testnet.
LAUNCHLY_CONTRACT=

# NEAR network + RPC.
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com

# Account names whose keys live in the near CLI keychain (used by
# verifier --submit and by keeper's printed commands, never by api.py).
VERIFIER_ACCOUNT=
KEEPER_ACCOUNT=

# 1Click (Intents): base override + optional JWT (else 0.2% fee).
# Mainnet only; quotes stay dry unless a human runs a live command.
ONECLICK_BASE=https://1click.chaindefuser.com
ONECLICK_JWT=

# Uploaded product assets (logo 512 KB, screenshots 1 MB, PNG/JPEG/WebP).
UPLOAD_DIR=./uploads

# Scoring agent service (agents/). Unset = verifier runs rules-only.
AGENT_URL=http://127.0.0.1:8091

# Meta Muse API key for the agent loop. Read by agents/ from THIS file
# too, so one .env serves both. Never commit.
MODEL_API_KEY=
