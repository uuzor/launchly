# Copy to agents/.env (never commit). The service also reads ../intents/.env
# as a fallback, so a key already there works with no changes.

# Meta Muse API key for the scoring loop. Unset (or URL/model unset) =
# deterministic mock mode (fixture scorer, mock:true). Never log or
# return this value.
MODEL_API_KEY=

# Meta Model API base + model. Defaults are the researched values below
# (dev.meta.ai/docs/quickstart); uncomment only to override.
#MODEL_BASE_URL=https://api.meta.ai/v1
#MODEL_ID=muse-spark-1.3

# Local bind for the scoring service (localhost only).
AGENT_PORT=8091

# Default batch concurrency (1-8).
AGENT_CONCURRENCY=4

# Per-request model timeout in ms.
AGENT_TIMEOUT_MS=45000

# Product chat: NEAR RPC + Launchly contract for the read-only tools.
NEAR_RPC=https://rpc.testnet.fastnear.com
LAUNCHLY_CONTRACT=

# Per-product memory dir (JSON facts, gitignored) + auto-extract toggle.
AGENT_DATA_DIR=./data
AGENT_MEMORY_UPDATE=on

# Shared operator token: gates POST /memory/clear (same value as the
# Python backend's OPERATOR_TOKEN).
OPERATOR_TOKEN=
